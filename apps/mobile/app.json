{
  "expo": {
    "name": "Talkin",
    "slug": "talkin",
    "scheme": "talkin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030707",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.humanacademy.talkin",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Talkin usa o microfone para gravar reuniões presenciais.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "ai.humanacademy.talkin",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "O Talkin usa o microfone para gravar reuniões."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "796c5d97-64d0-4ac7-b0aa-69ea5449b2c2"
      }
    },
    "owner": "luizfpires"
  }
}
